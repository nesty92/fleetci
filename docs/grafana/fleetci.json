      "id": 21
    },
    {
      "type": "timeseries",
      "title": "Lost, draining and notices",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (increase(fleetci_instances_lost_total[$__rate_interval]))",
