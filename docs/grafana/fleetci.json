          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, class) (rate(fleetci_vm_held_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{class}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
