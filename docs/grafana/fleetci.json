      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "id": 20
    },
    {
      "type": "timeseries",
      "title": "Instances created and deleted",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 47,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class, operation) (increase(fleetci_class_instance_operations_total[$__rate_interval]))",
          "legendFormat": "{{operation}} {{class}}",
          "datasource": {
