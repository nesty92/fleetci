    },
    {
      "type": "row",
      "title": "Host and cache disks",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 63,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 24
    },
    {
      "type": "timeseries",
      "title": "CPUs and memory used of the budget",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance, host) (fleetci_host_used_cpus) / max by (instance, host) (fleetci_host_budget_cpus)",
